{
  "name": "transformers-talk",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev transformers.md --open",
    "build": "slidev build transformers.md",
    "export": "slidev export transformers.md --with-clicks",
    "verify": "python3 scripts/verify-attention.py",
    "verify:torch": "python3 scripts/verify-attention.py --torch",
    "numbers": "python3 scripts/verify-attention.py --torch --emit-ts",
    "check:clicks": "node scripts/check-clicks.mjs",
    "check:overflow": "node scripts/check-overflow.mjs http://localhost:3030 73",
    "shots": "node scripts/screenshot.mjs http://localhost:3030 shots"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.49.0"
  }
}
